{
  "name": "moviebooking",
  "version": "1.0.0",
  "main": "backend/index.js",
  "scripts": {
    "start": "node backend/index.js",
    "dev": "vite --config frontend-react/vite.config.mts",
    "dev:server": "nodemon backend/index.js",
    "build": "vite build --config frontend-react/vite.config.mts",
    "format": "prettier --write \"frontend/**/*.{js,css,html}\" \"frontend-react/**/*.{ts,tsx,css,html,json}\" \"backend/**/*.js\" \"services/**/*.js\" package.json README.md && sql-formatter --fix --language postgresql supabase/migrations/20260910_initial_cinego.sql",
    "format:check": "prettier --check \"frontend/**/*.{js,css,html}\" \"frontend-react/**/*.{ts,tsx,css,html,json}\" \"backend/**/*.js\" \"services/**/*.js\" package.json README.md",
    "typecheck": "tsc -p frontend-react/tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && node --check backend/index.js && node --check backend/routes/movies.js && node --check backend/routes/cinema.js && node --check backend/routes/tickets.js && node --check backend/routes/assistant.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@langfuse/tracing": "^5.11.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^10.0.3",
    "openai": "^7.15.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.6",
    "sql-formatter": "^15.8.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
