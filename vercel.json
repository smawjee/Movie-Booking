{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend-dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/pdfkit/js/**"
    }
  },
  "crons": [{ "path": "/api/keepalive", "schedule": "17 6 * * *" }],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
